{
  "info": {
    "_postman_id": "54db12d4-4c22-4af9-a559-a2d548edb0f6",
    "name": "TicketPass API",
    "description": "Requests for the TicketPass API. Start the API at localhost:3000 or at https://ticketpass-api-production.up.railway.app, then run Authentication before Events and Bookings. Signup requests create temporary users; use a disposable database when running the full collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API is healthy', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign up organizer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('organizerEmail', 'organizer-' + Date.now() + '@example.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Organizer signup succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string');",
                  "  pm.expect(body.refreshToken).to.be.a('string');",
                  "  pm.collectionVariables.set('organizerAccessToken', body.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Organizer\",\n  \"email\": \"{{organizerEmail}}\",\n  \"password\": \"{{organizerPassword}}\",\n  \"role\": \"organizer\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/signup"
          }
        },
        {
          "name": "Sign up attendee",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('attendeeEmail', 'attendee-' + Date.now() + '@example.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Attendee signup succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string');",
                  "  pm.expect(body.refreshToken).to.be.a('string');",
                  "  pm.collectionVariables.set('attendeeAccessToken', body.accessToken);",
                  "  pm.collectionVariables.set('attendeeRefreshToken', body.refreshToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Attendee\",\n  \"email\": \"{{attendeeEmail}}\",\n  \"password\": \"{{attendeePassword}}\",\n  \"role\": \"attendee\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/signup"
          }
        },
        {
          "name": "Sign in attendee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Attendee signin succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('attendeeAccessToken', body.accessToken);",
                  "  pm.collectionVariables.set('attendeeRefreshToken', body.refreshToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{attendeeEmail}}\",\n  \"password\": \"{{attendeePassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/signin"
          }
        },
        {
          "name": "Refresh attendee tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh returns rotated tokens', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string');",
                  "  pm.expect(body.refreshToken).to.be.a('string');",
                  "  pm.collectionVariables.set('attendeeAccessToken', body.accessToken);",
                  "  pm.collectionVariables.set('attendeeRefreshToken', body.refreshToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{attendeeRefreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List events",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendeeAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/events"
          }
        },
        {
          "name": "Create event (organizer)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('futureEventDate', new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Event is created', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.exist;",
                  "  pm.collectionVariables.set('eventId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{organizerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Event\",\n  \"description\": \"Created from the TicketPass collection\",\n  \"venue\": \"Postman Hall\",\n  \"event_date\": \"{{futureEventDate}}\",\n  \"ticket_price\": 25,\n  \"total_seats\": 50\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/events"
          }
        },
        {
          "name": "Get event by ID",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendeeAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}"
          }
        },
        {
          "name": "Update event (organizer)",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{organizerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Postman Test Event\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}"
          }
        },
        {
          "name": "Attendee cannot create event (expect 403)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendeeAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should Be Rejected\",\n  \"venue\": \"Postman Hall\",\n  \"event_date\": \"{{futureEventDate}}\",\n  \"ticket_price\": 25,\n  \"total_seats\": 10\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/events"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Attendee is forbidden from creating events', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create booking (attendee)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Booking is created for the selected event', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.event_id).to.eql(Number(pm.collectionVariables.get('eventId')));",
                  "  pm.collectionVariables.set('bookingId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendeeAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": {{eventId}},\n  \"seatsBooked\": {{seatsBooked}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/bookings"
          }
        },
        {
          "name": "List all bookings (organizer)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{organizerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/bookings"
          }
        },
        {
          "name": "Attendee cannot list all bookings (expect 403)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendeeAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/bookings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Attendee cannot view all bookings', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List my bookings (attendee)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendeeAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/bookings/my-bookings"
          }
        },
        {
          "name": "Get my booking by ID",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendeeAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/bookings/my-bookings/{{bookingId}}"
          }
        },
        {
          "name": "Update my booking status",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendeeAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"cancelled\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/bookings/my-bookings/{{bookingId}}"
          }
        },
        {
          "name": "Delete my booking",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendeeAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/bookings/my-bookings/{{bookingId}}"
          }
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete event (organizer)",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{organizerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "organizerEmail", "value": "", "type": "string" },
    { "key": "attendeeEmail", "value": "", "type": "string" },
    { "key": "organizerPassword", "value": "Password123!", "type": "string" },
    { "key": "attendeePassword", "value": "Password123!", "type": "string" },
    { "key": "organizerAccessToken", "value": "", "type": "string" },
    { "key": "attendeeAccessToken", "value": "", "type": "string" },
    { "key": "attendeeRefreshToken", "value": "", "type": "string" },
    { "key": "futureEventDate", "value": "", "type": "string" },
    { "key": "eventId", "value": "", "type": "string" },
    { "key": "bookingId", "value": "", "type": "string" },
    { "key": "seatsBooked", "value": "2", "type": "string" }
  ]
}
